# 后端 systemd 环境文件模板
# 生产路径：/etc/myweb/myweb.env（权限 600，由 root 持有）
# 真实密码见本机桌面 服务器.txt，请勿提交真实凭据到代码仓库

MYWEB_DB_URL=jdbc:mysql://127.0.0.1:3306/myweb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYWEB_DB_USER=myweb
MYWEB_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SERVER_PORT=8081
